{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false
  },
  "include": ["js/**/*.js", "server/**/*.js", "test/**/*.js"],
  "exclude": ["node_modules", "js/vendor"]
}
