# Crea una Notion Integration su https://www.notion.so/my-integrations
# e copia il token qui sotto
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID del database "Le mie spese" su Notion
# Lo trovi nell'URL della pagina: notion.so/{DATABASE_ID}?v=...
NOTION_DATABASE_ID=38920ecb267f494e97262a207076c0b2

# ── Opzionali ──
# Porta e host (host 0.0.0.0 richiesto per Docker / hosting cloud)
PORT=3000
HOST=0.0.0.0

# Basic Auth: se IMPOSTATE ENTRAMBE, l'app chiede utente e password.
# Consigliato se esponi l'app su internet (hosting cloud).
# Lascia commentate per l'uso in locale senza autenticazione.
# BASIC_AUTH_USER=marco
# BASIC_AUTH_PASS=una-password-lunga

# In produzione, imposta NODE_ENV=production: rende OBBLIGATORIE le due
# variabili BASIC_AUTH_* (senza, il server si rifiuta di partire).
# NODE_ENV=production
